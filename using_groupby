import pandas as pd

data = {
    'Department': ['Sales', 'Sales', 'IT', 'IT', 'IT', 'HR'],
    'Employee': ['Alice', 'Bob', 'Charlie', 'David', 'Edward', 'Eva'],
    'Salary': [50000, 60000, 75000, 80000, 70000, 55000],
    'Bonus': [5000, 6000, 8000, 9000, 7500, 4000]
}

df = pd.DataFrame(data)

      #average salary per department
print(df.groupby('Department')['Salary'].mean())
